{
  "checks": {
    "forge-rust-format-fix": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml",
          "nvim/rust/forge/tests/**/*.rs",
          "nvim/rust/forge/crates/**/tests/**/*.rs"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--package",
          "{package}"
        ],
        "directory": "nvim/rust/forge",
        "label": "Affected Rust package formatting fix",
        "category": "format",
        "package_manager": "cargo",
        "prepare": true
      }
    },
    "forge-rust-workspace-format-fix": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/rust-toolchain.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--all"
        ],
        "directory": "nvim/rust/forge",
        "label": "Shared-configuration Rust formatting fix",
        "category": "format",
        "prepare": true
      }
    },
    "forge-rust-tests": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "test",
          "--profile",
          "dev",
          "--locked",
          "--package",
          "{package}",
          "--tests",
          "--",
          "--test-threads=2"
        ],
        "directory": "nvim/rust/forge",
        "label": "Affected Forge Rust package tests",
        "category": "test",
        "package_manager": "cargo"
      }
    },
    "forge-rust-workspace-tests": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/Cargo.lock",
          "nvim/rust/forge/rust-toolchain.toml",
          "nvim/rust/forge/.cargo/**",
          "nvim/rust/forge/vendor/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "test",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--tests",
          "--",
          "--test-threads=2"
        ],
        "directory": "nvim/rust/forge",
        "label": "Shared-configuration Rust tests",
        "category": "test"
      }
    },
    "forge-rust-clippy": {
      "trigger": {
        "auto": false,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "clippy",
          "--profile",
          "dev",
          "--locked",
          "--package",
          "{package}",
          "--all-targets",
          "--",
          "-D",
          "warnings"
        ],
        "directory": "nvim/rust/forge",
        "label": "Forge Clippy",
        "category": "lint",
        "package_manager": "cargo"
      }
    },
    "forge-build": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "build",
          "--profile",
          "dev",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Forge debug executable",
        "category": "build"
      }
    },
    "forge-build-release": {
      "trigger": {
        "auto": false
      },
      "action": {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
