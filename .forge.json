{
  "checks": {
    "git-whitespace": {
      "trigger": {
        "auto": true
      },
      "action": {
        "command": [
          "git",
          "diff",
          "--check",
          "HEAD"
        ],
        "label": "Check patch whitespace",
        "category": "format"
      }
    },
    "lua-benchmark": {
      "trigger": {
        "paths": [
          "nvim/lua/forge/**",
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/lua.nu",
          "benchmarks",
          "--full",
          "--timeout",
          "120sec"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Run Lua benchmarks",
        "category": "test",
        "input": true,
        "after": [
          "rust-build"
        ]
      }
    },
    "lua-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/lua/forge/**",
          "nvim/lua/github/**",
          "nvim/lua/rust_sidecar/**",
          "nvim/lua/markdown_math/**",
          "nvim/lua/markdown_code.lua",
          "nvim/lua/plugins/forge.lua",
          "nvim/tests/**/*.lua",
          ".forge/checks/lua-tests.nu"
        ],
        "exclude": [
          "nvim/tests/forge/background_host.lua",
          "nvim/tests/forge/command_clue.lua",
          "nvim/tests/forge/client_initialize_host.lua",
          "nvim/tests/forge/client_executable_copy.lua",
          "nvim/tests/forge/client_callback_isolation.lua",
          "nvim/tests/forge/commit_generation_host.lua",
          "nvim/tests/forge/commit_host.lua",
          "nvim/tests/forge/commit_large_output_host.lua",
          "nvim/tests/forge/composer_autopair.lua",
          "nvim/tests/forge/commit_status_reuse.lua",
          "nvim/tests/forge/commit_settings_host.lua",
          "nvim/tests/forge/exchange_history.lua",
          "nvim/tests/forge/forge_client.lua",
          "nvim/tests/forge/harness_control_responsiveness.lua",
          "nvim/tests/forge/harness_completion.lua",
          "nvim/tests/forge/harness_checks_host.lua",
          "nvim/tests/forge/harness_admission_host.lua",
          "nvim/tests/forge/harness_checks.lua",
          "nvim/tests/forge/harness_checkpoint_host.lua",
          "nvim/tests/forge/harness_automatic_checks.lua",
          "nvim/tests/forge/harness_attachments_host.lua",
          "nvim/tests/forge/harness_approval_resume_host.lua",
          "nvim/tests/forge/harness_acp_children_host.lua",
          "nvim/tests/forge/harness_access_host.lua",
          "nvim/tests/forge/harness_prompt_history_host.lua",
          "nvim/tests/forge/harness_plan_browsing_host.lua",
          "nvim/tests/forge/harness_package_checks.lua",
          "nvim/tests/forge/harness_native_import_host.lua",
          "nvim/tests/forge/harness_model_pins_host.lua",
          "nvim/tests/forge/harness_message_folds_host.lua",
          "nvim/tests/forge/harness_markdown_render.lua",
          "nvim/tests/forge/harness_markdown_folds.lua",
          "nvim/tests/forge/harness_interrupt_host.lua",
          "nvim/tests/forge/harness_input_timeout_host.lua",
          "nvim/tests/forge/harness_input_timeout.lua",
          "nvim/tests/forge/harness_host.lua",
          "nvim/tests/forge/harness_task_recovery_host.lua",
          "nvim/tests/forge/harness_tasks_host.lua",
          "nvim/tests/forge/walkthrough_host.lua",
          "nvim/tests/forge/harness_skill_reads_host.lua",
          "nvim/tests/forge/harness_replan_host.lua",
          "nvim/tests/forge/harness_provider_switch_host.lua",
          "nvim/tests/forge/language_syntax_host.lua",
          "nvim/tests/forge/plan_review_host.lua",
          "nvim/tests/forge/markdown_viewport.lua",
          "nvim/tests/forge/markdown_math_render.lua",
          "nvim/tests/forge/markdown_math_async.lua",
          "nvim/tests/forge/lsp_tools_host.lua",
          "nvim/tests/forge/plan_review_definition_host.lua",
          "nvim/tests/forge/plan_review_calls_host.lua",
          "nvim/tests/forge/plan_declaration_presentation_host.lua",
          "nvim/tests/forge/plan_checks_host.lua",
          "nvim/tests/forge/receive_initialize_host.lua",
          "nvim/tests/forge/pr_context_host.lua",
          "nvim/tests/forge/source_host.lua",
          "nvim/tests/forge/source_document_presentation.lua",
          "nvim/tests/forge/semantic_execution_host.lua",
          "nvim/tests/forge/status_recent_commits_host.lua",
          "nvim/tests/forge/status_push_host.lua",
          "nvim/tests/forge/status_popup_host.lua",
          "nvim/tests/forge/status_ignore_staged_host.lua",
          "nvim/tests/forge/status_host.lua",
          "nvim/tests/forge/status_staging_host_gutters.lua",
          "nvim/tests/forge/status_staging_host_flows.lua",
          "nvim/tests/forge/status_staging_host_edges.lua",
          "nvim/tests/forge/status_virtual_hunk_merge.lua",
          "nvim/tests/forge/status_untracked_optimistic.lua",
          "nvim/tests/forge/status_staging_source_changes.lua",
          "nvim/tests/forge/status_word_wrap_host.lua",
          "nvim/tests/forge/per_edit_routes_host.lua",
          "nvim/tests/forge/empty_diff_cursor.lua",
          "nvim/tests/forge/harness_codex_activity.lua",
          "nvim/tests/forge/harness_plan_checks.lua",
          "nvim/tests/forge/harness_new.lua",
          "nvim/tests/forge/host_initialize.lua",
          "nvim/tests/forge/syntax_resource_acceptance.lua",
          "nvim/tests/forge/performance_acceptance.lua",
          "nvim/tests/forge/perf.lua",
          "nvim/tests/forge/streaming_performance.lua",
          "nvim/tests/forge/harness_acp_real.lua",
          "nvim/tests/forge/harness_owned_agents_real.lua",
          "nvim/tests/forge/windows_ui_parity.lua",
          "nvim/tests/forge/unix_client_shutdown.lua",
          "nvim/tests/forge/plan_navigation_languages_host.lua",
          "nvim/tests/forge/sidecar_manual.lua",
          "nvim/tests/**/fixtures/**",
          "nvim/tests/**/support/**",
          "nvim/tests/forge/plan_review_question_response_host.lua"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/lua.nu",
          "affected",
          "--timeout",
          "30sec"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "fixture": {
            "type": "string",
            "description": "Exact Lua fixture path",
            "required": false,
            "default": ""
          },
          "suite": {
            "type": "string",
            "description": "Feature suite or affected",
            "required": false,
            "default": "affected"
          }
        },
        "label": "Run Lua tests",
        "category": "test",
        "input": true
      }
    },
    "lua-test-live-integration": {
      "trigger": {
        "paths": [
          "nvim/lua/forge/**",
          "nvim/rust/forge/**",
          "nvim/tests/forge/support/review_host.lua"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/lua.nu",
          "live-integration",
          "--full",
          "--timeout",
          "120sec"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Exact live integration fixture paths (omit for the whole suite)",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Run Lua live integration",
        "category": "test",
        "input": true,
        "after": [
          "rust-build"
        ]
      }
    },
    "lua-test-mock-integration": {
      "trigger": {
        "paths": [
          "nvim/lua/forge/**",
          "nvim/rust/forge/**",
          "nvim/tests/forge/support/review_host.lua"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/lua.nu",
          "mock-integration",
          "--full",
          "--timeout",
          "120sec"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Exact mock integration fixture paths (omit for the whole suite)",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Run Lua mock integration",
        "category": "test",
        "input": true,
        "after": [
          "rust-build"
        ]
      }
    },
    "nushell-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "**/*.nu"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/nushell.nu"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Check Nushell syntax",
        "category": "check",
        "input": true
      }
    },
    "rulesync-global-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          "rulesync-global/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Preview global Rulesync",
        "category": "check"
      }
    },
    "rulesync-global-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Update global Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-global-preview"
        ]
      }
    },
    "rulesync-local-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          ".rulesync/**",
          "rulesync.jsonc"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run"
        ],
        "label": "Preview local Rulesync",
        "category": "check"
      }
    },
    "rulesync-local-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate"
        ],
        "label": "Update local Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-local-preview"
        ]
      }
    },
    "rust-build": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "build",
          "--profile",
          "dev",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable",
        "category": "build"
      }
    },
    "rust-build-release": {
      "trigger": {},
      "action": {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable (release)",
        "category": "build"
      }
    },
    "rust-format": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml",
          "nvim/rust/forge/tests/**/*.rs",
          "nvim/rust/forge/crates/**/tests/**/*.rs"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "format"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Format Rust",
        "category": "format",
        "prepare": true,
        "input": true
      }
    },
    "rust-format-workspace": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/rust-toolchain.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--all"
        ],
        "directory": "nvim/rust/forge",
        "label": "Format Rust workspace",
        "category": "format",
        "prepare": true
      }
    },
    "rust-lint": {
      "trigger": {
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "clippy"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Lint Rust",
        "category": "lint",
        "input": true
      }
    },
    "rust-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "test"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Run Rust tests",
        "category": "test",
        "input": true
      }
    },
    "rust-test-workspace": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/Cargo.lock",
          "nvim/rust/forge/rust-toolchain.toml",
          "nvim/rust/forge/.cargo/**",
          "nvim/rust/forge/vendor/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "test",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--tests"
        ],
        "directory": "nvim/rust/forge",
        "label": "Run Rust workspace tests",
        "category": "test"
      }
    }
  }
}