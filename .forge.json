{
  "checks": {
    "git-whitespace": {
      "trigger": {
        "auto": true
      },
      "action": {
        "command": [
          "git",
          "diff",
          "--check",
          "HEAD"
        ],
        "label": "Check patch whitespace",
        "category": "format"
      }
    },
    "lua-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/lua/forge/**",
          "nvim/lua/github/**",
          "nvim/lua/rust_sidecar/**",
          "nvim/lua/markdown_math/**",
          "nvim/lua/markdown_code.lua",
          "nvim/lua/plugins/forge.lua",
          "nvim/lua/*/tests/**/*.lua",
          ".forge/checks/lua-tests.nu",
          "nvim/lua/git/**"
        ],
        "exclude": [
          "nvim/lua/*/tests/fixtures/**",
          "nvim/lua/*/tests/support/**",
          "nvim/lua/*/tests/plans/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          ".forge/checks/lua-tests.nu",
          "--affected",
          "{files}"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Changed repository paths; with none, every test runs",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Run affected Lua tests",
        "category": "test",
        "after": [
          "rust-build"
        ]
      }
    },
    "lua-test-select": {
      "trigger": {},
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          ".forge/checks/lua-tests.nu",
          "{tests}"
        ],
        "inputs": {
          "tests": {
            "type": "array",
            "description": "Test files, source files, directories, test names, or name::case",
            "required": true
          }
        },
        "label": "Run selected Lua tests",
        "category": "test",
        "after": [
          "rust-build"
        ]
      }
    },
    "nushell-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "**/*.nu"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          ".forge/checks/nushell-syntax.nu",
          "{files}"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Nushell files to check; with none, every repository Nushell file",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Check Nushell syntax",
        "category": "check"
      }
    },
    "rulesync-global-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          "rulesync-global/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Preview global Rulesync",
        "category": "check"
      }
    },
    "rulesync-global-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Update global Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-global-preview"
        ]
      }
    },
    "rulesync-local-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          ".rulesync/**",
          "rulesync.jsonc"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run"
        ],
        "label": "Preview local Rulesync",
        "category": "check"
      }
    },
    "rulesync-local-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate"
        ],
        "label": "Update local Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-local-preview"
        ]
      }
    },
    "rust-build": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "build",
          "--profile",
          "dev",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable",
        "category": "build"
      }
    },
    "rust-build-release": {
      "trigger": {},
      "action": {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable (release)",
        "category": "build"
      }
    },
    "rust-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "check",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--all-targets"
        ],
        "directory": "nvim/rust/forge",
        "label": "Type-check Rust workspace",
        "category": "check"
      }
    },
    "rust-format": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--all",
          "--",
          "--check"
        ],
        "directory": "nvim/rust/forge",
        "label": "Check Rust formatting",
        "category": "format"
      }
    },
    "rust-format-fix": {
      "trigger": {},
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--all"
        ],
        "directory": "nvim/rust/forge",
        "label": "Apply Rust formatting",
        "category": "format",
        "prepare": true
      }
    },
    "rust-lint": {
      "trigger": {},
      "action": {
        "command": [
          "cargo",
          "clippy",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--all-targets",
          "--",
          "-D",
          "warnings"
        ],
        "directory": "nvim/rust/forge",
        "label": "Lint Rust workspace",
        "category": "lint"
      }
    },
    "rust-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "nextest",
          "run",
          "--cargo-profile",
          "dev",
          "--locked",
          "--workspace",
          "-E",
          "{filter}"
        ],
        "inputs": {
          "filter": {
            "type": "string",
            "description": "Nextest filterset, such as package(forge-git), rdeps(forge-diff), or package(forge-git) & test(=writer::case)",
            "required": false,
            "default": "all()"
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Run Rust tests",
        "category": "test"
      }
    }
  }
}