{
  "checks": {
    "git-whitespace": {
      "trigger": {
        "auto": true
      },
      "action": {
        "command": [
          "git",
          "diff",
          "--check",
          "HEAD"
        ],
        "label": "Check patch whitespace",
        "category": "format"
      }
    },
    "lua-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/lua/forge/**",
          "nvim/lua/github/**",
          "nvim/lua/rust_sidecar/**",
          "nvim/lua/markdown_math/**",
          "nvim/lua/markdown_code.lua",
          "nvim/lua/plugins/forge.lua",
          "nvim/lua/*/tests/**/*.lua",
          ".forge/checks/lua-tests.nu",
          "nvim/lua/git/**"
        ],
        "exclude": [
          "nvim/lua/*/tests/fixtures/**",
          "nvim/lua/*/tests/support/**",
          "nvim/lua/*/tests/plans/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          ".forge/checks/lua-tests.nu",
          "check",
          "affected"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "fixture": {
            "type": "string",
            "description": "Lua test file, test name, or name::scenario",
            "required": false,
            "default": ""
          },
          "suite": {
            "type": "string",
            "description": "Source area (such as status, harness, or lsp), plugin or source directory, all, or affected for the tests covering the changed paths",
            "required": false,
            "default": "affected"
          }
        },
        "label": "Run Lua tests",
        "category": "test",
        "input": true
      }
    },
    "nushell-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "**/*.nu"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/nushell.nu"
        ],
        "inputs": {
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          }
        },
        "label": "Check Nushell syntax",
        "category": "check",
        "input": true
      }
    },
    "rulesync-global-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          "rulesync-global/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Preview global Rulesync",
        "category": "check"
      }
    },
    "rulesync-global-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Update global Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-global-preview"
        ]
      }
    },
    "rulesync-local-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          ".rulesync/**",
          "rulesync.jsonc"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run"
        ],
        "label": "Preview local Rulesync",
        "category": "check"
      }
    },
    "rulesync-local-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate"
        ],
        "label": "Update local Rulesync",
        "category": "check",
        "prepare": true,
        "after": [
          "rulesync-local-preview"
        ]
      }
    },
    "rust-build": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "build",
          "--profile",
          "dev",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable",
        "category": "build"
      }
    },
    "rust-build-release": {
      "trigger": {},
      "action": {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked",
          "--bin",
          "forge"
        ],
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable (release)",
        "category": "build"
      }
    },
    "rust-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml",
          "nvim/rust/forge/tests/**/*.rs",
          "nvim/rust/forge/crates/**/tests/**/*.rs"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "check"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "all, lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          }
        },
        "label": "Check",
        "category": "check",
        "input": true
      }
    },
    "rust-check-workspace": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/Cargo.lock",
          "nvim/rust/forge/rust-toolchain.toml",
          "nvim/rust/forge/.cargo/**",
          "nvim/rust/forge/vendor/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "check",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--all-targets"
        ],
        "directory": "nvim/rust/forge",
        "label": "Type-check Rust workspace",
        "category": "check"
      }
    },
    "rust-format": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml",
          "nvim/rust/forge/tests/**/*.rs",
          "nvim/rust/forge/crates/**/tests/**/*.rs"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "format"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "all, lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Check Rust formatting",
        "category": "format",
        "input": true
      }
    },
    "rust-format-fix": {
      "trigger": {
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml",
          "nvim/rust/forge/tests/**/*.rs",
          "nvim/rust/forge/crates/**/tests/**/*.rs"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "format-fix"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "all, lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Apply Rust formatting",
        "category": "format",
        "prepare": true,
        "input": true
      }
    },
    "rust-format-workspace": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/rust-toolchain.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "fmt",
          "--all",
          "--",
          "--check"
        ],
        "directory": "nvim/rust/forge",
        "label": "Check Rust workspace formatting",
        "category": "format"
      }
    },
    "rust-lint": {
      "trigger": {
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "clippy"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "all, lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Lint Rust",
        "category": "lint",
        "input": true
      }
    },
    "rust-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/src/**/*.rs",
          "nvim/rust/forge/crates/**/*.rs",
          "nvim/rust/forge/crates/**/Cargo.toml"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "nu",
          "--no-config-file",
          "--stdin",
          "nvim/tools/checks/rust.nu",
          "test"
        ],
        "inputs": {
          "executable": {
            "type": "string",
            "description": "all, lib, test:<name>, bin:<name>",
            "required": false,
            "default": "lib"
          },
          "files": {
            "type": "array",
            "description": "Repository paths",
            "required": false,
            "source": "changed_files"
          },
          "full": {
            "type": "boolean",
            "description": "Whole workspace",
            "required": false,
            "default": false
          },
          "package": {
            "type": "string",
            "description": "Cargo package",
            "required": false,
            "default": ""
          },
          "test": {
            "type": "string",
            "description": "Exact test name",
            "required": false,
            "default": ""
          }
        },
        "label": "Run Rust tests",
        "category": "test",
        "input": true
      }
    },
    "rust-test-workspace": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/Cargo.toml",
          "nvim/rust/forge/Cargo.lock",
          "nvim/rust/forge/rust-toolchain.toml",
          "nvim/rust/forge/.cargo/**",
          "nvim/rust/forge/vendor/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "cargo",
          "test",
          "--profile",
          "dev",
          "--locked",
          "--workspace",
          "--tests"
        ],
        "directory": "nvim/rust/forge",
        "label": "Run Rust workspace tests",
        "category": "test"
      }
    }
  }
}
