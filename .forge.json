{
  "checks": {
    "git-whitespace": {
      "trigger": {
        "auto": true
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/git-whitespace.nu",
              "adapter"
            ]
          }
        },
        "label": "Check patch whitespace",
        "category": "lint"
      }
    },
    "lua-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/lua/forge/**",
          "nvim/lua/github/**",
          "nvim/lua/rust_sidecar/**",
          "nvim/lua/markdown_math/**",
          "nvim/lua/markdown_code.lua",
          "nvim/lua/plugins/forge.lua",
          "nvim/lua/*/tests/**/*.lua",
          ".forge/checks/lua-tests.nu",
          "nvim/lua/git/**"
        ],
        "exclude": [
          "nvim/lua/*/tests/fixtures/**",
          "nvim/lua/*/tests/support/**",
          "nvim/lua/*/tests/plans/**"
        ]
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/lua-tests.nu",
              "adapter"
            ]
          }
        },
        "label": "Run affected Lua tests",
        "category": "test",
        "after": [
          "rust-build"
        ]
      }
    },
    "nushell-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "**/*.nu"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/nushell-syntax.nu",
              "adapter"
            ]
          }
        },
        "label": "Check Nushell syntax",
        "category": "typecheck"
      }
    },
    "rulesync-global-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          "rulesync-global/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Preview global Rulesync",
        "category": "custom"
      }
    },
    "rulesync-global-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--config",
          "rulesync-global/rulesync.jsonc",
          "--input-roots",
          "rulesync-global/.rulesync",
          "--global"
        ],
        "label": "Update global Rulesync",
        "category": "custom",
        "prepare": true,
        "after": [
          "rulesync-global-preview"
        ]
      }
    },
    "rulesync-local-preview": {
      "trigger": {
        "auto": true,
        "paths": [
          ".rulesync/**",
          "rulesync.jsonc"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "command": [
          "rulesync",
          "generate",
          "--dry-run"
        ],
        "label": "Preview local Rulesync",
        "category": "custom"
      }
    },
    "rulesync-local-update": {
      "trigger": {},
      "action": {
        "command": [
          "rulesync",
          "generate"
        ],
        "label": "Update local Rulesync",
        "category": "custom",
        "prepare": true,
        "after": [
          "rulesync-local-preview"
        ]
      }
    },
    "rust-build": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "**/node_modules/**"
        ]
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/cargo.nu",
              "adapter",
              "--bin",
              "forge"
            ]
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable",
        "category": "build"
      }
    },
    "rust-build-release": {
      "trigger": {},
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/cargo.nu",
              "adapter",
              "--bin",
              "forge",
              "--release"
            ]
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Build Rust executable (release)",
        "category": "build"
      }
    },
    "rust-check": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/cargo.nu",
              "adapter"
            ]
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Type-check Rust workspace",
        "category": "typecheck"
      }
    },
    "rust-format": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/cargo.nu",
              "adapter"
            ]
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Check Rust formatting",
        "category": "format"
      }
    },
    "rust-lint": {
      "trigger": {},
      "action": {
        "adapter": {
          "script": {
            "command": [
              "nu",
              "--stdin",
              "--no-config-file",
              ".forge/checks/cargo.nu",
              "adapter"
            ]
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Lint Rust workspace",
        "category": "lint"
      }
    },
    "rust-test": {
      "trigger": {
        "auto": true,
        "paths": [
          "nvim/rust/forge/**"
        ],
        "exclude": [
          "**/target/**",
          "nvim/rust/forge/**/*.md"
        ]
      },
      "action": {
        "adapter": {
          "rust_nextest": {
            "cargo_profile": "dev",
            "nextest_profile": "default",
            "locked": true,
            "features": [],
            "all_features": false,
            "cargo_args": []
          }
        },
        "directory": "nvim/rust/forge",
        "label": "Run Rust tests",
        "category": "test"
      }
    }
  }
}