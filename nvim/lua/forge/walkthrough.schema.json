{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-walkthrough.schema.json",
  "title": "Forge Walkthrough",
  "description": "Guided review walkthrough stored as .walkthrough.json at a repository root.",
  "type": "object",
  "required": ["version", "flow", "overview", "root", "commit", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 12 },
    "flow": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/flowNode" } },
    "overview": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "flowNode": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/flowNode" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["title", "subtasks"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "subtasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subtask" } }
      }
    },
    "subtask": {
      "type": "object",
      "required": ["title", "changes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } }
      }
    },
    "change": {
      "type": "object",
      "required": ["action", "kind", "target", "note"],
      "additionalProperties": false,
      "dependentRequired": {
        "annotation": ["file", "line"],
        "file": ["line", "annotation"],
        "line": ["file", "annotation"]
      },
      "properties": {
        "action": { "enum": ["Add", "Modify", "Remove"] },
        "kind": { "$ref": "#/$defs/changeKind" },
        "role": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "annotation": { "$ref": "#/$defs/annotation" }
      }
    },
    "changeKind": {
      "enum": ["Class", "Struct", "Enum", "Trait", "Interface", "Test", "Config", "Function", "Method", "Constant", "Field"]
    },
    "annotation": {
      "type": "object",
      "required": ["title", "comment"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "comment": { "type": "string", "minLength": 1 }
      }
    }
  }
}
