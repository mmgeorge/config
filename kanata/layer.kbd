;; APTv3 with the Angle mod on a staggered keyboard.
;; Left Alt holds Meta. Right Alt provides the native modifier.
;; Caps Lock taps Escape and holds Control on the base layer.

(defcfg
  process-unmapped-keys yes
)

(defsrc
  1    2    3    4    5    6    7    8    9    0
  q    w    e    r    t    y    u    i    o    p
  a    s    d    f    g    h    j    k    l    ;
  z    x    c    v    b    n    m    ,    .    /
  caps lalt spc ret tab lctl
)

(defvirtualkeys
  release-numpad (release-layer numpad)
)

(defalias
  escctl (tap-hold-press 0 150 esc lctl)
  ;; Release Meta and its numpad together even if a numpad key is still held.
  alt    (multi (layer-while-held alt) (on-release tap-vkey release-numpad))
  numpad (layer-while-held numpad)
  caret  (tap-hold-press 0 150 S-6 @numpad)
)

(deflayer base
  _      _    _    _    _    _    _    _    _    _
  w      g    d    f    b    q    l    u    o    y
  r      s    t    h    k    j    n    e    a    i
  c      m    p    v    x    z    ;    ,    .    /
  @escctl @alt spc _    tab  lrld-next
)

;; Use the same leftward rotation for Meta's bottom-left symbols as for the letters.
(deflayer alt
  f1      f2     f3     f4     f5     _     _     _     S-,   S-.
  home    pgup   pgdn   end    _      S-5   S-7   -     S-8   S-=
  left    (fork up A-S-s (lsft rsft)) (fork down A-S-t (lsft rsft)) rght _ S-1 tab bspc S-9 S-0
  S-2     grv    @caret S-3    S-grv  S-4   S--   =     S-[   S-]
  @numpad _      spc    _      A-tab  _
)

;; Tap-hold can buffer Alt's release. Check the physical key before emitting a numpad output.
(deftemplate numpad-key (output)
  (switch ((input real lalt)) $output break () _ break)
)

(deflayer numpad
  _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    (t! numpad-key =) (t! numpad-key 7) (t! numpad-key 8) (t! numpad-key 9) (t! numpad-key =)
  _    _    _    _    _    (t! numpad-key ,) (t! numpad-key 4) (t! numpad-key 5) (t! numpad-key 6) (t! numpad-key ,)
  _    _    _    _    _    (t! numpad-key .) (t! numpad-key 1) (t! numpad-key 2) (t! numpad-key 3) (t! numpad-key .)
  _    _    (t! numpad-key 0) (t! numpad-key spc) _ _
)
